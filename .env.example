# Copy this file to `.env` and fill in the values.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- API ---
API_PORT=8000

# --- Knowledge base ---
# Directory scanned for documents at startup. Leave empty to use <project_root>/data.
DATA_DIR=

# --- Qdrant ---
# Leave QDRANT_HOST empty to use an in-memory Qdrant (data is NOT persisted).
# Docker Compose sets QDRANT_HOST=qdrant automatically.
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Hosted / Qdrant Cloud: use QDRANT_URL (and an API key) instead of QDRANT_HOST.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# --- Embedding model (optional override) ---
# EMBEDDING_MODEL=text-embedding-3-large
